APP_NAME=CiviDash
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Europe/Berlin

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Enables the nightly `dashboard:reset --force` schedule (routes/console.php), which wipes the
# default and Regensburg/Demo City demo tenants, reseeds Regensburg with content, leaves Demo
# City as an empty sandbox, and re-activates the demo admin accounts (test@example.com,
# demo@example.com). Only set to true on demo/showcase instances, never on a production install
# with real dashboard data. See docs/deployment/seeding.md.
DASHBOARD_DEMO_RESET=false

# Password for the seeded admin accounts (test@example.com, demo@example.com). If unset, the
# seeders generate a random 20-character password and print it once to the console output.
# SEED_ADMIN_PASSWORD=

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# FILESYSTEM_URL=/storage
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CORS: additional frontend origin (e.g. Vite dev server).
# Subdomain origins are derived automatically from APP_URL.
# FRONTEND_URL=http://localhost:5173

# CIVITAS/CORE data sync (optional)
# CIVITAS_ENABLED=false
# CIVITAS_DRIVER=ngsi-ld                 # 'ngsi-ld' (Stellio, default) or 'sensorthings' (FROST)
# CIVITAS_API_URL=http://localhost:8080/context/ngsi-ld   # CORE V1.6.2 Stellio NGSI-LD path
# CIVITAS_CONTEXT_URL=                   # JSON-LD @context URL (leave empty for broker default)
# CIVITAS_OAUTH_TOKEN_URL=
# CIVITAS_OAUTH_CLIENT_ID=
# CIVITAS_OAUTH_CLIENT_SECRET=
# CIVITAS_OAUTH_SCOPE=
# CIVITAS_SYNC_SCHEDULE=daily
# CIVITAS_SYNC_MODE=pull                 # pull|push|bidirectional; only 'pull' is implemented
# CIVITAS_SYNC_PRUNE_REMOVED=false       # Prune local records absent from a full source sync

# Keycloak SSO (optional, for CIVITAS/CORE integration)
# KEYCLOAK_SSO_ENABLED=false
# KEYCLOAK_BASE_URL=http://localhost:8080          # Public URL Keycloak issues tokens for
# KEYCLOAK_BASE_URL_INTERNAL=http://keycloak:8080  # Server-side override for token/userinfo (DDEV/Docker/stack)
# KEYCLOAK_REALM=civitas
# KEYCLOAK_CLIENT_ID=cividash-dashboard
# KEYCLOAK_REDIRECT_URI=http://localhost:8000/admin/auth/keycloak/callback
# KEYCLOAK_CLIENT_SECRET=cividash-secret     # Confidential client secret (see below)
#
# bootstrap admin with KC_BOOTSTRAP_ADMIN_USERNAME / KC_BOOTSTRAP_ADMIN_PASSWORD.
