# ==============================================================================
# CiviDash — Production environment template (Kubernetes / Docker Compose)
# ==============================================================================
# Documents every env var required to run the cividash-app / cividash-web container
# images built from docker/production/. Copy to a real .env (compose) or split
# across a ConfigMap (non-secret) and a Secret (secret) in Kubernetes.
#
# Injection model:
#   - Env is injected into the container BEFORE the entrypoint runs.
#   - The entrypoint runs `php artisan config:cache` (+ route/view caches),
#     which FREEZES env() values into the compiled config. Changing an env var
#     therefore requires a container restart (re-run the entrypoint).
#
# Conventions:
#   - "Secret"    = store in a k8s Secret (or Compose secret). Never commit.
#   - "ConfigMap" = non-sensitive, safe in a k8s ConfigMap / plain compose env.
#   - All secret values are intentionally left BLANK below.
# ==============================================================================


# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_NAME=CiviDash                    # ConfigMap. Display name; also fed to VITE_APP_NAME at build time.
APP_ENV=production                   # ConfigMap. Must be 'production' (disables debug pages, dev tooling).
APP_KEY=                             # Secret. 32-byte app encryption key. Generate: php artisan key:generate --show
                                     #   Produces e.g. base64:....  Inject from a k8s Secret — do NOT commit.
APP_DEBUG=false                      # ConfigMap. MUST be false in production (no stack traces to users).
APP_URL=https://dashboard.example.org   # ConfigMap. Canonical public URL. Used for absolute links, asset URLs, cookies.

APP_TIMEZONE=Europe/Berlin           # ConfigMap. Default timezone for the application.
APP_LOCALE=de                        # ConfigMap. Default locale (supported: de, en).
APP_FALLBACK_LOCALE=en               # ConfigMap. Fallback locale when a key is missing.
APP_FAKER_LOCALE=de_DE               # ConfigMap. Faker locale (only relevant if seeding demo data).

APP_MAINTENANCE_DRIVER=file          # ConfigMap. Maintenance-mode driver. 'file' works per-pod; use 'cache' for shared.

# Logging — in containers, log to stderr so the platform (k8s/Docker) collects it.
LOG_CHANNEL=stderr                   # ConfigMap. Send logs to stderr for container log aggregation.
LOG_STACK=single                     # ConfigMap. Stack channel members (used when LOG_CHANNEL=stack).
LOG_DEPRECATIONS_CHANNEL=null        # ConfigMap. Where deprecation notices go ('null' = off).
LOG_LEVEL=warning                    # ConfigMap. Minimum level to log in production.

BCRYPT_ROUNDS=12                     # ConfigMap. Bcrypt cost factor for password hashing.


# ------------------------------------------------------------------------------
# Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
# DB_HOST points at the database SERVICE, not the app. In compose this is the
# 'cividash-db' service (smoke testing); in k8s it is the DB Service / StatefulSet
# DNS name, or an external managed-DB host.
# The image also ships pdo_mysql, but MariaDB/MySQL is an untested alternative.
DB_CONNECTION=pgsql                  # ConfigMap. Driver. Uses pdo_pgsql against PostgreSQL 16.
DB_HOST=cividash-db                  # ConfigMap. DB service/StatefulSet hostname (compose smoke: 'cividash-db').
DB_PORT=5432                         # ConfigMap. PostgreSQL port.
DB_DATABASE=cividash                 # ConfigMap. Database name.
DB_USERNAME=cividash                 # Secret (recommended). Application DB user.
DB_PASSWORD=                         # Secret. Application DB password — inject from k8s Secret.


# ------------------------------------------------------------------------------
# Session / Cache / Queue  (all backed by the database)
# ------------------------------------------------------------------------------
# Database-backed drivers are chosen so multiple pods share state without Redis.
# Requires the sessions / cache / jobs tables (created by migrations).
SESSION_DRIVER=database              # ConfigMap. Shared session store across pods.
SESSION_LIFETIME=120                 # ConfigMap. Session lifetime in minutes.
SESSION_ENCRYPT=false                # ConfigMap. Encrypt session payloads at rest.
SESSION_PATH=/                       # ConfigMap. Cookie path.
SESSION_DOMAIN=null                  # ConfigMap. Cookie domain ('null' = derive from APP_URL host).
SESSION_SECURE_COOKIE=true           # ConfigMap. Send session cookie only over HTTPS (true behind TLS).

CACHE_STORE=database                 # ConfigMap. Shared cache store across pods.

QUEUE_CONNECTION=database            # ConfigMap. Queue backend. Drained by the 'queue' workload
                                     #   (php artisan queue:work). No queued jobs exist yet — forward-looking.

BROADCAST_CONNECTION=log             # ConfigMap. Broadcasting driver (unused; 'log' is a safe no-op).


# ------------------------------------------------------------------------------
# Media / Filesystem
# ------------------------------------------------------------------------------
# The 'public' disk is switchable: 'local' stores uploads on the pod filesystem
# (needs a shared/persistent volume across pods), 's3' offloads to object
# storage (RustFS / MinIO / AWS S3) and is the recommended multi-pod default.
FILESYSTEM_DISK=local                # ConfigMap. Default app disk (private storage).
FILAMENT_FILESYSTEM_DISK=public      # ConfigMap. Disk Filament uses for admin uploads.

PUBLIC_DISK_DRIVER=local             # ConfigMap. 'local' (volume) or 's3' (object storage) for public media.
FILESYSTEM_PUBLIC_URL=               # ConfigMap. Public base URL for media. local -> "/storage";
                                     #   s3 -> the public bucket base URL (e.g. https://cdn.example.org/cividash).

# --- Object storage (only when PUBLIC_DISK_DRIVER=s3 or FILESYSTEM_DISK=s3) ---
AWS_ACCESS_KEY_ID=                   # Secret. S3/RustFS/MinIO access key.
AWS_SECRET_ACCESS_KEY=               # Secret. S3/RustFS/MinIO secret key.
AWS_DEFAULT_REGION=us-east-1         # ConfigMap. Region (MinIO/RustFS accept any value, e.g. us-east-1).
AWS_BUCKET=                          # ConfigMap. Default S3 bucket name.
PUBLIC_S3_BUCKET=                    # ConfigMap. Bucket for the public disk (falls back to AWS_BUCKET if empty).
AWS_ENDPOINT=                        # ConfigMap. Custom endpoint for S3-compatible storage (RustFS/MinIO).
                                     #   Leave EMPTY for real AWS S3.
AWS_USE_PATH_STYLE_ENDPOINT=false    # ConfigMap. true for MinIO/RustFS (path-style); false for AWS S3.


# ------------------------------------------------------------------------------
# Reverse proxy / TLS termination
# ------------------------------------------------------------------------------
# Requests reach the app through cividash-web (nginx) and typically an ingress /
# load balancer. Trusting the proxy ensures correct client IP + HTTPS scheme
# detection (X-Forwarded-* headers).
TRUSTED_PROXIES=*                    # ConfigMap. Trusted proxy IPs/CIDRs. '*' trusts all forwarders
                                     #   (acceptable when only the ingress/LB can reach the pod).

# CORS: extra allowed frontend origin (subdomains of APP_URL are derived automatically).
# FRONTEND_URL=https://app.example.org   # ConfigMap. Optional additional CORS origin (e.g. a separate SPA host).


# ------------------------------------------------------------------------------
# CIVITAS / CORE integration  (optional — set CIVITAS_ENABLED=true to use)
# ------------------------------------------------------------------------------
# Pulls urban data from a CIVITAS/CORE platform (Stellio NGSI-LD broker) and
# maps it into the dashboard's tiles/categories/metrics. OAuth2 client-
# credentials are obtained from Keycloak.
CIVITAS_ENABLED=false                # ConfigMap. Master switch for the CORE data sync.
CIVITAS_DRIVER=ngsi-ld               # ConfigMap. 'ngsi-ld' (Stellio, default) or 'sensorthings' (FROST).
CIVITAS_API_URL=                     # ConfigMap. CORE API base URL. Stellio V1.6.2 path: .../context/ngsi-ld
CIVITAS_CONTEXT_URL=                 # ConfigMap. JSON-LD @context URL (leave empty to use the broker default).

# --- OAuth2 client credentials for the CORE/Keycloak token endpoint ---
CIVITAS_OAUTH_TOKEN_URL=             # ConfigMap. Keycloak token endpoint used to fetch access tokens.
CIVITAS_OAUTH_CLIENT_ID=             # ConfigMap. OAuth2 client id for the sync service account.
CIVITAS_OAUTH_CLIENT_SECRET=         # Secret. OAuth2 client secret — inject from k8s Secret.
CIVITAS_OAUTH_SCOPE=                 # ConfigMap. Optional OAuth2 scope (empty if none required).

# --- Sync behaviour ---
CIVITAS_SYNC_SCHEDULE=daily          # ConfigMap. Sync cadence (driven by the scheduler workload).
CIVITAS_SYNC_BATCH_SIZE=100          # ConfigMap. Records fetched/processed per batch.
CIVITAS_SYNC_RETRY_ATTEMPTS=3        # ConfigMap. Retry attempts on a failed sync request.
CIVITAS_SYNC_RETRY_DELAY=5           # ConfigMap. Delay (seconds) between retries.
CIVITAS_SYNC_PRUNE_REMOVED=false     # ConfigMap. Remove local records absent from a full source sync.


# ------------------------------------------------------------------------------
# Keycloak SSO  (optional — set KEYCLOAK_SSO_ENABLED=true to use)
# ------------------------------------------------------------------------------
# Lets admin/editor users sign in to the Filament panel via CORE's Keycloak
# (OpenID Connect / Socialite). Shares KEYCLOAK_CLIENT_* with config/services.php.
KEYCLOAK_SSO_ENABLED=false           # ConfigMap. Master switch for Keycloak admin SSO.
KEYCLOAK_BASE_URL=                   # ConfigMap. Public Keycloak base URL (issuer host).
KEYCLOAK_REALM=civitas               # ConfigMap. Keycloak realm name.
KEYCLOAK_CLIENT_ID=                  # ConfigMap. OIDC client id for the dashboard.
KEYCLOAK_CLIENT_SECRET=              # Secret. OIDC client secret — inject from k8s Secret.
KEYCLOAK_REDIRECT_URI=https://dashboard.example.org/admin/auth/keycloak/callback   # ConfigMap. OAuth callback URL (must match the Keycloak client config).
# KEYCLOAK_BASE_URL_INTERNAL=        # ConfigMap. Optional in-cluster Keycloak URL if it differs from the public one.
