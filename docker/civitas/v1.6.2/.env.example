# Local Stellio NGSI-LD broker — version + port + credential pins.
#
# Copy to .env in this directory (docker/civitas/v1.6.2/.env) before running
# setup.sh. This .env is consumed ONLY by docker compose in this directory and
# is unrelated to the Laravel app's root-level .env.
#
#   cp docker/civitas/v1.6.2/.env.example docker/civitas/v1.6.2/.env
#
# Bump STELLIO_DOCKER_TAG to upgrade the broker; keep the dependency image
# tags coherent with the chosen Stellio release (see notes below).

# -----------------------------------------------------------------------------
# Stellio version (api-gateway + search-service + subscription-service)
# -----------------------------------------------------------------------------
# Pinned to 2.21.0 — latest STABLE release (2025-02-26). Do NOT use 'latest-dev'
# (a moving target on the develop branch).
STELLIO_DOCKER_TAG=2.21.0

# Spring profile for all Stellio services.
ENVIRONMENT=docker

# Authentication DISABLED — broker is fully open, no JWT validation. Matches the
# official .env default at the 2.21.0 tag. Wired into each service as
# APPLICATION_AUTHENTICATION_ENABLED.
STELLIO_AUTHENTICATION_ENABLED=false

# -----------------------------------------------------------------------------
# Dependency images — coherent with the 2.21.0 docker-compose.yml.
# (The develop branch pins newer tags; do NOT mix sets.)
# -----------------------------------------------------------------------------
# PostgreSQL 16 / TimescaleDB 2.17.2 / PostGIS 3.5
POSTGRES_IMAGE_TAG=16-2.17.2-3.5

# Confluent cp-kafka, KRaft mode (no Zookeeper)
KAFKA_IMAGE_TAG=7.6.0

# -----------------------------------------------------------------------------
# Database credentials (match the 2.21.0 .env defaults)
# -----------------------------------------------------------------------------
POSTGRES_USER=stellio
POSTGRES_PASSWORD=stellio_password

# -----------------------------------------------------------------------------
# Host port mappings
# -----------------------------------------------------------------------------
# NGSI-LD entry point (api-gateway :8080), published to the host. This is a
# separate compose project from the V2 stack — do not run both on the same port
# concurrently. Reach it from the host as http://localhost:8090/ngsi-ld/v1 and
# from inside DDEV as http://host.docker.internal:8090/ngsi-ld/v1.
API_GATEWAY_HOST_PORT=8090

# Kafka external listener (only for external tooling; not needed by the app).
KAFKA_HOST_PORT=29092
