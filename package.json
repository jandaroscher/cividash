{
    "name": "cividash",
    "description": "CiviDash: open-source sustainability dashboard for municipalities (Laravel, Filament, Vue 3)",
    "repository": {
        "type": "git",
        "url": "https://gitlab.opencode.de/regensburg_next/cividash"
    },
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint resources/js",
        "lint:fix": "eslint resources/js --fix",
        "test:unit": "vitest run",
        "test:e2e": "playwright test",
        "test:e2e:seed": "ddev exec php artisan e2e:seed-tenant-resolution --json"
    },
    "dependencies": {
        "@egjs/flicking-plugins": "^4.8.1",
        "@egjs/vue3-flicking": "^4.17.0",
        "@fontsource/inter": "^5.3.0",
        "@fontsource/open-sans": "^5.3.0",
        "@fontsource/roboto": "^5.3.0",
        "@lottiefiles/dotlottie-wc": "^0.9.28",
        "@unhead/vue": "^3.4.0",
        "@vueuse/components": "^14.4.0",
        "dompurify": "^3.4.15",
        "pinia": "^3.0.4",
        "vue": "^3.5.42",
        "vue-flex-waterfall": "^2.3.1",
        "vue-router": "^4.6.3",
        "vue-slider-component": "^4.1.0-beta.7"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@eslint/js": "^9.39.5",
        "@pinia/testing": "^1.0.3",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/test-utils": "^2.5.0",
        "axios": "^1.20.0",
        "concurrently": "^10.0.5",
        "eslint": "^9.17.0",
        "eslint-plugin-vue": "^10.10.0",
        "globals": "^17.12.0",
        "happy-dom": "^20.14.0",
        "jsdom": "^25.0.1",
        "laravel-vite-plugin": "^1.2.0",
        "sass-embedded": "^1.104.0",
        "tailwindcss": "^4.0.0",
        "vite": "^6.2.4",
        "vitest": "^4.1.11"
